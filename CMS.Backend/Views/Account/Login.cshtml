@{
    ViewData["Title"] = "Đăng nhập Admin";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập Admin - DoanCMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <style>
        @@font-face {
            font-family: 'OPPOSans';
            src: url('/fonts/OPPOSans-R.ttf') format('truetype');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }
        @@font-face {
            font-family: 'OPPOSans';
            src: url('/fonts/OPPOSans-B.ttf') format('truetype');
            font-weight: 700 900;
            font-style: normal;
            font-display: swap;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'OPPOSans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        body {
            background: url('https://www.transparenttextures.com/patterns/wood-pattern.png'), 
                        linear-gradient(135deg, #c8a882 0%, #b8956e 30%, #a0784c 60%, #8b653b 100%);
            background-blend-mode: overlay;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        /* Floating bubbles background */
        .bubble {
            position: absolute;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 50%;
            pointer-events: none;
            bottom: -100px;
            animation: floatUp 12s infinite ease-in;
        }

        @@keyframes floatUp {
            0% {
                transform: translateY(0) scale(1) rotate(0deg);
                opacity: 0;
            }
            10% {
                opacity: 0.8;
            }
            90% {
                opacity: 0.8;
            }
            100% {
                transform: translateY(-110vh) scale(1.3) rotate(360deg);
                opacity: 0;
            }
        }

        /* Glassmorphism Card */
        .login-card {
            background: rgba(45, 27, 78, 0.35);
            backdrop-filter: blur(25px) saturate(180%);
            -webkit-backdrop-filter: blur(25px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 40px;
            border-radius: 28px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
            width: 420px;
            position: relative;
            z-index: 10;
            animation: slideIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.96);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .login-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .logo-box {
            display: inline-block;
            margin-bottom: 12px;
            width: 220px;
            height: 60px;
        }

        /* Form Inputs */
        .form-label {
            color: rgba(255, 248, 235, 0.7);
            font-size: 13.5px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .form-control-custom {
            background: rgba(255, 255, 255, 0.04) !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            color: #fff8eb !important;
            border-radius: 14px !important;
            padding: 12px 16px !important;
            font-size: 14px !important;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }

        .form-control-custom:focus {
            background: rgba(255, 255, 255, 0.08) !important;
            border-color: rgba(245, 158, 11, 0.5) !important;
            box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.15) !important;
            outline: none !important;
        }

        .form-control-custom::placeholder {
            color: rgba(255, 248, 235, 0.3) !important;
        }

        /* Buttons */
        .btn-submit {
            background: linear-gradient(135deg, #fbbf24 0%, #ef4444 50%, #ec4899 100%) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            color: white !important;
            font-weight: 700 !important;
            font-size: 14.5px !important;
            padding: 12px !important;
            border-radius: 14px !important;
            width: 100%;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.25) !important;
        }

        .btn-submit:hover {
            transform: scale(1.02) translateY(-1px) !important;
            box-shadow: 0 12px 25px rgba(245, 158, 11, 0.35) !important;
            opacity: 0.95;
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.25);
            color: #fca5a5;
            border-radius: 14px;
            padding: 12px 16px;
            font-size: 13px;
            margin-bottom: 20px;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <!-- Bubbles -->
    <div class="bubble" style="width:40px; height:40px; left:10%; animation-duration:14s;"></div>
    <div class="bubble" style="width:20px; height:20px; left:25%; animation-duration:11s; animation-delay:1s;"></div>
    <div class="bubble" style="width:60px; height:60px; left:40%; animation-duration:18s; animation-delay:3s;"></div>
    <div class="bubble" style="width:30px; height:30px; left:60%; animation-duration:13s; animation-delay:2s;"></div>
    <div class="bubble" style="width:50px; height:50px; left:75%; animation-duration:16s; animation-delay:4s;"></div>
    <div class="bubble" style="width:25px; height:25px; left:90%; animation-duration:10s; animation-delay:0.5s;"></div>

    <!-- Login Box -->
    <div class="login-card">
        <div class="login-header">
            <div class="logo-box">
                <svg viewBox="0 0 220 60" style="width: 100%; height: 100%;" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="fishGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color: #fbbf24" />
                            <stop offset="50%" style="stop-color: #ef4444" />
                            <stop offset="100%" style="stop-color: #ec4899" />
                        </linearGradient>
                        <linearGradient id="tailGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color: #ef4444" />
                            <stop offset="100%" style="stop-color: #8b5cf6" />
                        </linearGradient>
                        <linearGradient id="finGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" style="stop-color: #f59e0b" />
                            <stop offset="100%" style="stop-color: #ef4444" />
                        </linearGradient>
                        <linearGradient id="textGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" style="stop-color: #ffffff" />
                            <stop offset="40%" style="stop-color: #ffd269" />
                            <stop offset="100%" style="stop-color: #ff8838" />
                        </linearGradient>
                        <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                            <feGaussianBlur stdDeviation="2" result="blur" />
                            <feComposite in="SourceGraphic" in2="blur" operator="over" />
                        </filter>
                    </defs>
                    
                    <g transform="translate(32, 30)">
                        <circle cx="0" cy="0" r="23" fill="none" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1" stroke-dasharray="3 3">
                            <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="20s" repeatCount="indefinite"/>
                        </circle>
                        <circle cx="0" cy="0" r="19" fill="none" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1" />
                        
                        <path d="M6,-3 C12,-15 25,-18 22,-6 C20,3 10,2 6,-3 Z" fill="url(#tailGrad)" opacity="0.8">
                            <animate attributeName="d" values="M6,-3 C12,-15 25,-18 22,-6 C20,3 10,2 6,-3 Z; M6,-3 C14,-13 27,-15 22,-6 C18,0 11,1 6,-3 Z; M6,-3 C12,-15 25,-18 22,-6 C20,3 10,2 6,-3 Z" dur="3s" repeatCount="indefinite" />
                        </path>
                        <path d="M8,-5 C14,-10 20,-12 18,-6 C16,0 10,-2 8,-5 Z" fill="url(#finGrad)" opacity="0.9" />
                        
                        <path d="M-12,8 C-18,0 -12,-8 -3,-10 C4,-11 10,-4 6,3 C3,8 -4,14 -12,8 Z" fill="url(#fishGrad)" />
                        
                        <path d="M-6,-11 C-2,-18 2,-20 0,-15 C-2,-12 -4,-11 -6,-11 Z" fill="url(#finGrad)" />
                        <path d="M-8,10 C-10,18 -16,16 -12,12 C-9,9 -7,9 -8,10 Z" fill="url(#finGrad)" />
                        
                        <circle cx="-10" cy="2" r="1.8" fill="white" />
                        <circle cx="-10.5" cy="1.8" r="0.9" fill="#1a0f2e" />
                        <circle cx="-11" cy="1.5" r="0.4" fill="white" />
                        
                        <path d="M-7,4 C-5,2 -5,-1 -7,-3" fill="none" stroke="rgba(255, 255, 255, 0.3)" stroke-width="1" />
                        
                        <circle cx="-15" cy="-8" r="1.5" fill="rgba(255, 255, 255, 0.4)">
                            <animate attributeName="cy" values="-8;-20;-8" dur="3s" repeatCount="indefinite" />
                            <animate attributeName="opacity" values="0.4;0;0.4" dur="3s" repeatCount="indefinite" />
                        </circle>
                        <circle cx="-18" cy="-3" r="1" fill="rgba(255, 255, 255, 0.3)">
                            <animate attributeName="cy" values="-3;-15;-3" dur="2.5s" repeatCount="indefinite" />
                            <animate attributeName="opacity" values="0.3;0;0.3" dur="2.5s" repeatCount="indefinite" />
                        </circle>
                    </g>
                    
                    <text x="82" y="27" font-family="'OPPOSans', -apple-system, sans-serif" font-size="24" font-weight="900" fill="url(#textGrad)" letter-spacing="1.5" filter="url(#glow)">
                        DoanCMS
                    </text>
                    <text x="82" y="44" font-family="'OPPOSans', -apple-system, sans-serif" font-size="9" font-weight="800" fill="#ffd269" letter-spacing="4" opacity="0.85">
                        AQUA & PET
                    </text>
                </svg>
            </div>
            <div style="font-size: 13px; color: rgba(255, 248, 235, 0.5); font-weight: 500; letter-spacing: 0.5px;">ADMIN PANEL SYSTEM</div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
            </div>
        }

        <form method="post" asp-action="Login" asp-controller="Account">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                <input type="text" name="username" class="form-control form-control-custom" placeholder="Tên đăng nhập..." required />
            </div>
            <div class="mb-4">
                <label class="form-label">Mật khẩu</label>
                <input type="password" name="password" class="form-control form-control-custom" placeholder="Mật khẩu..." required />
            </div>
            <button type="submit" class="btn btn-submit">
                <i class="bi bi-shield-lock-fill me-1"></i> Xác nhận đăng nhập
            </button>
        </form>
        
        <div style="text-align: center; margin-top: 24px; font-size: 11px; color: rgba(255,248,235,0.3);">
            © 2026 DoanCMS · Trần Văn Đoàn
        </div>
    </div>
</body>
</html>