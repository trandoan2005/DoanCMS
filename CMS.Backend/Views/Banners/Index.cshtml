@model IEnumerable<CMS.Data.Entities.Banner>

@{
    ViewData["Title"] = "Quản lý Banner";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Quản lý Banner</h2>
    <a asp-action="Create" class="btn btn-primary">Thêm Banner mới</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Thứ tự</th>
            <th>Hình Ảnh</th>
            <th>Tiêu đề 1</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DisplayOrder</td>
                <td><img src="@item.ImageUrl" alt="Banner" style="max-height: 80px;" /></td>
                <td>@item.Title1</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Đang hiện</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã ẩn</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>
