@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Sửa Banner";
}

<h2>Sửa Banner</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />
            
            <div class="mb-3 card p-3 bg-light border-0">
                <label class="form-label fw-bold text-dark"><i class="bi bi-image me-1"></i>Hình ảnh banner</label>
                
                <div class="mb-2">
                    <label class="form-label text-muted small mb-1">Tải lên hình ảnh từ máy tính (để trống nếu giữ nguyên):</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                </div>
                
                <div>
                    <label class="form-label text-muted small mb-1">Hoặc nhập liên kết ảnh (URL) mới:</label>
                    <input name="imageUrl" class="form-control" placeholder="Nhập URL nếu không upload ảnh mới..." />
                </div>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Badge" class="control-label"></label>
                <input asp-for="Badge" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Title1" class="control-label"></label>
                <input asp-for="Title1" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Title2" class="control-label"></label>
                <input asp-for="Title2" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DisplayOrder" class="control-label"></label>
                <input asp-for="DisplayOrder" class="form-control" type="number" />
            </div>

            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Trở về</a>
            </div>
        </form>
    </div>
    <div class="col-md-6">
        <p>Ảnh hiện tại:</p>
        @if(!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="Banner Preview" style="max-width: 100%; border-radius: 8px;" />
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
