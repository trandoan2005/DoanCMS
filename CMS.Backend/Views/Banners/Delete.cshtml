@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Xoá Banner";
}

<h2>Xoá Banner</h2>
<h3>Bạn có chắc chắn muốn xoá banner này không?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ImageUrl)
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.ImageUrl" style="max-height: 150px; border-radius: 8px;" />
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title1)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title1)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DisplayOrder)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DisplayOrder)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xoá vĩnh viễn" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Trở về</a>
    </form>
</div>
